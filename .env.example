# ─────────────────────────────────────────────────────────────
# VideoDB CRM — environment variables
# Copy to .env.local for local dev. In production these live in Vercel.
# ─────────────────────────────────────────────────────────────

# Supabase (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://rvaorknlkhvosrbeoopd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_lXKZRfqjY8-VZp_UC1hJBg_a5b1BtAN

# Ingestion secret — proves the server is allowed to write via crm_ingest().
# Server-side only. NEVER expose to the browser.
INGEST_SECRET=replace-me

# Per-channel webhook secrets. Each external tool must include the matching
# value as ?key=... in its webhook URL (or an x-webhook-secret header).
FORM_WEBHOOK_SECRET=replace-me
SMARTLEAD_WEBHOOK_SECRET=replace-me
HEYREACH_WEBHOOK_SECRET=replace-me
CLAY_WEBHOOK_SECRET=replace-me

# Public base URL of this app (used to show ready-to-paste webhook URLs
# on the Settings page). e.g. https://videodb-crm.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
